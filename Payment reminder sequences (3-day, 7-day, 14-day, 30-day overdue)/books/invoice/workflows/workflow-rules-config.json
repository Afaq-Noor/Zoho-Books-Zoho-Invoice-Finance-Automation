{
    "workflow_rules": [
        {
            "name": "Send 3-Day Overdue Reminder",
            "module": "Invoice",
            "type": "Event Based",
            "action_type": "Edited",
            "execute_when": "Any field is updated",
            "execute_on": "Edited each time",
            "condition": {
                "field": "cf_reminder_trigger",
                "operator": "equals",
                "value": "3-day"
            },
            "actions": [
                {
                    "type": "Email Alert",
                    "alert_name": "3-Day Overdue Alert"
                },
                {
                    "type": "Field Update",
                    "field": "cf_reminder_trigger",
                    "value": null
                }
            ]
        },
